function fail(message) {
  console.error(`garcon-amp-setup: ${message}`);
  process.exit(2);
}

function shellQuote(value) {
  return `'${value.replaceAll("'", `'\\''`)}'`;
}

function parseProfileName(name) {
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(name)) {
    throw new Error(`invalid profile name: ${name || '<empty>'}`);
  }
  return name;
}

function normalizeConfigLine(line) {
  return line.endsWith('\r') ? line.slice(0, -1) : line;
}

function trimConfigWhitespace(value) {
  return value.replace(/^[\t ]+|[\t ]+$/g, '');
}

function isConfigComment(line) {
  return /^[\t ]*#/.test(line);
}

function nextNonCommentLineIndex(lines, index) {
  let nextIndex = index + 1;
  while (isConfigComment(normalizeConfigLine(lines[nextIndex] ?? ''))) nextIndex += 1;
  return nextIndex;
}

function parseConfigAssignment(line) {
  const separator = line.indexOf('=');
  if (separator === -1) return undefined;
  return {
    name: trimConfigWhitespace(line.slice(0, separator)),
    value: trimConfigWhitespace(line.slice(separator + 1)),
  };
}

function ensureTrailingNewline(content) {
  return content.endsWith('\n') ? content : `${content}\n`;
}

function inspectLegacyUserConfig(rawLines) {
  const legacyAliases = [];
  let aliasSectionCount = 0;
  let defaultProfileBlockExists = false;
  let defaultProfileExists = false;
  let inAliasSection = false;
  let invalidLegacyAliasLine;
  let roleLineIndex = -1;

  for (let index = 0; index < rawLines.length; index++) {
    const line = normalizeConfigLine(rawLines[index]);
    if (isConfigComment(line)) continue;
    if (inAliasSection) {
      if (trimConfigWhitespace(line) === '') {
        inAliasSection = false;
        continue;
      }
      if (!line.startsWith('[')) continue;
      inAliasSection = false;
    }

    if (line === '[spec-alias]') {
      aliasSectionCount += 1;
      inAliasSection = true;
      continue;
    }
    if (/^\[profile:\S+\]$/.test(line)) {
      if (line === `[profile:${defaultProfileName}]`) defaultProfileBlockExists = true;
      for (let roleIndex = 0; roleIndex < ROLE_NAMES.length; roleIndex += 1) {
        index = nextNonCommentLineIndex(rawLines, index);
      }
      continue;
    }

    const unindentedLine = line.replace(/^[\t ]+/, '');
    if (unindentedLine.startsWith('spec-alias:')) {
      const body = line.slice(0, line.length - unindentedLine.length)
        + unindentedLine.slice('spec-alias:'.length);
      if (trimConfigWhitespace(body) === '') {
        invalidLegacyAliasLine ??= index + 1;
        continue;
      }
      legacyAliases.push({
        body,
        index,
      });
      continue;
    }
    const assignment = parseConfigAssignment(line);
    if (assignment === undefined) continue;
    if (assignment.name === 'default-profile') defaultProfileExists = true;
    if (roleLineIndex === -1 && ROLE_NAMES.includes(assignment.name)) {
      roleLineIndex = index;
    }
  }

  return {
    aliasSectionCount,
    defaultProfileBlockExists,
    defaultProfileExists,
    invalidLegacyAliasLine,
    legacyAliases,
    roleLineIndex,
  };
}

function renderLegacyUserConfigUpgrade(content, filePath) {
  let rawLines = content.split('\n');
  let inspection = inspectLegacyUserConfig(rawLines);
  let aliasesUpgraded = false;
  let profileUpgraded = false;

  if (inspection.invalidLegacyAliasLine !== undefined) {
    fail(
      `invalid role default at ${filePath}:${inspection.invalidLegacyAliasLine}; `
      + 'expected <specialist-role>=<spec>',
    );
  }
  if (inspection.legacyAliases.length > 0) {
    if (inspection.aliasSectionCount > 0) {
      fail(
        `legacy spec aliases cannot be combined with [spec-alias] in role default: ${filePath}`,
      );
    }
    const legacyIndexes = new Set(inspection.legacyAliases.map(({ index }) => index));
    const firstAliasIndex = inspection.legacyAliases[0].index;
    const carriageReturn = rawLines[firstAliasIndex].endsWith('\r') ? '\r' : '';
    const aliasAssignments = inspection.legacyAliases.map(({ body, index }) => {
      const lineEnding = rawLines[index].endsWith('\r') ? '\r' : '';
      return `${body}${lineEnding}`;
    });
    rawLines = rawLines.filter((_, index) => !legacyIndexes.has(index));
    const aliasBlock = [
      `[spec-alias]${carriageReturn}`,
      ...aliasAssignments,
    ];
    const followingLine = rawLines[firstAliasIndex];
    if (
      followingLine !== undefined
      && trimConfigWhitespace(normalizeConfigLine(followingLine)) !== ''
      && !normalizeConfigLine(followingLine).startsWith('[')
    ) {
      aliasBlock.push(carriageReturn);
    }
    rawLines.splice(firstAliasIndex, 0, ...aliasBlock);
    aliasesUpgraded = true;
    inspection = inspectLegacyUserConfig(rawLines);
  }

  if (inspection.roleLineIndex === -1) {
    return { content: rawLines.join('\n'), aliasesUpgraded, profileUpgraded };
  }
  if (inspection.defaultProfileExists) {
    fail(
      `legacy unprefixed roles cannot be combined with default-profile in role default: ${filePath}`,
    );
  }
  if (inspection.defaultProfileBlockExists) {
    fail(
      `legacy unprefixed roles cannot be combined with [profile:default] in role default: ${filePath}`,
    );
  }
  const carriageReturn = rawLines[inspection.roleLineIndex].endsWith('\r') ? '\r' : '';
  rawLines.splice(
    inspection.roleLineIndex,
    0,
    `default-profile=default${carriageReturn}`,
    carriageReturn,
    `[profile:${defaultProfileName}]${carriageReturn}`,
  );
  profileUpgraded = true;
  return { content: rawLines.join('\n'), aliasesUpgraded, profileUpgraded };
}

async function upgradeLegacyUserConfig(content, filePath, identity) {
  const upgrade = renderLegacyUserConfigUpgrade(content, filePath);
  if (!upgrade.aliasesUpgraded && !upgrade.profileUpgraded) return upgrade;
  const current = await requireOwnedRegularFileIfPresent(filePath, 'role defaults file');
  let currentContent;
  try {
    currentContent = current ? await readFile(filePath, 'utf8') : undefined;
  } catch (error) {
    fail(`cannot reread role defaults file before upgrade: ${filePath}: ${error.message}`);
  }
  if (
    !current
    || current.dev !== identity.dev
    || current.ino !== identity.ino
    || currentContent !== content
  ) {
    fail(`role defaults file changed during setup; rerun to use it: ${filePath}`);
  }
  try {
    await atomicWrite(filePath, upgrade.content, current.mode & 0o777);
  } catch (error) {
    fail(`cannot upgrade role defaults file: ${filePath}: ${error.message}`);
  }
  return upgrade;
}

function parseRawProfileBlock(lines, headerIndex, profileName, filePath, kind) {
  const assignments = {};
  let index = headerIndex;
  for (const role of ROLE_NAMES) {
    index = nextNonCommentLineIndex(lines, index);
    const line = lines[index] ?? '';
    const assignment = parseConfigAssignment(line);
    if (assignment?.name !== role || assignment.value === '') {
      fail(
        `invalid profile "${profileName}" in ${kind} at ${filePath}:${index + 1}; `
        + `expected ${role}=<spec>`,
      );
    }
    assignments[role] = { spec: assignment.value, line: index + 1 };
  }
  return { assignments, lastIndex: index };
}

function parseRawRoleAssignments(
  rawSpecs,
  filePath,
  {
    aliases,
    requireAll,
    resolveAliases,
    kind,
    profileName,
  },
) {
  const specs = {};
  const profileContext = profileName === undefined ? '' : ` in profile "${profileName}"`;
  for (const name of ROLE_NAMES) {
    const assignment = rawSpecs[name];
    if (assignment === undefined) continue;
    let parsed;
    try {
      parsed = parseAgentSpecList(
        assignment.spec,
        resolveAliases ? aliases : undefined,
      );
      if (name !== 'oracle' && parsed.length !== 1) {
        throw new Error('only oracle may configure multiple agent specs');
      }
    } catch (error) {
      fail(
        `invalid ${name} ${kind}${profileContext} `
        + `at ${filePath}:${assignment.line}: ${error.message}`,
      );
    }
    specs[name] = canonicalAgentSpecList(parsed);
  }
  if (requireAll) {
    for (const role of ROLE_NAMES) {
      if (specs[role] === undefined) {
        fail(`${kind}${profileContext} is missing ${role}: ${filePath}`);
      }
    }
  }
  return specs;
}

function rawRoleSpecLabels(rawSpecs) {
  return Object.fromEntries(ROLE_NAMES.flatMap((name) => {
    const assignment = rawSpecs[name];
    return assignment === undefined ? [] : [[name, assignment.spec]];
  }));
}

function validateStoredSpecLabel(label, resolvedSpec) {
  let canonicalLabel;
  try {
    canonicalLabel = canonicalAgentSpec(parseAgentSpec(label));
  } catch {}
  if (canonicalLabel !== undefined) {
    if (canonicalLabel !== resolvedSpec) {
      throw new Error('canonical spec label does not match its role spec');
    }
    return;
  }

  const separator = label.indexOf(':');
  const name = separator === -1 ? label : label.slice(0, separator);
  parseSpecAliasName(name);
  if (separator !== -1) {
    const level = label.slice(separator + 1);
    if (!level || /[:,\u0000\r\n]/.test(level)) throw new Error('invalid spec alias level');
  }
}

function parseStoredSpecLabels(rawLabels, specs, filePath, kind) {
  const labels = { ...specs };
  for (const name of ROLE_NAMES) {
    const assignment = rawLabels[name];
    if (assignment === undefined) continue;
    const values = assignment.spec.split(',');
    const resolvedSpecs = specs[name].split(',');
    try {
      if (values.some((value) => value === '')) {
        throw new Error('spec label list contains an empty entry');
      }
      if (values.length !== resolvedSpecs.length) {
        throw new Error('spec label count does not match the role spec count');
      }
      if (new Set(values).size !== values.length) {
        throw new Error('spec label list contains a duplicate');
      }
      for (const [index, value] of values.entries()) {
        validateStoredSpecLabel(value, resolvedSpecs[index]);
      }
    } catch (error) {
      fail(`invalid ${name} spec label in ${kind} at ${filePath}:${assignment.line}: ${error.message}`);
    }
    labels[name] = assignment.spec;
  }
  return labels;
}

function requireProfile(profileName, config, filePath, kind) {
  const specs = config.profiles.get(profileName);
  if (specs === undefined) {
    fail(`${kind} selects unknown default profile "${profileName}": ${filePath}`);
  }
  return specs;
}

function parseConfigAssignments(
  content,
  filePath,
  {
    allowAliases = false,
    allowBaseProfile = false,
    allowDefaultProfile = false,
    allowLegacyAliases = false,
    allowProfiles = false,
    allowSpecLabels = false,
    requireAll = false,
    resolveAliases = false,
    kind = 'role default',
  } = {},
) {
  const aliases = new Map();
  const rawSpecs = {};
  const rawSpecLabels = {};
  const rawProfiles = new Map();
  const seen = new Set();
  let aliasSectionSeen = false;
  let baseProfile;
  let defaultProfile;
  let legacyAliasesSeen = false;
  const lines = content.split('\n').map(normalizeConfigLine);

  const addSpecAlias = (name, target, lineNumber) => {
    try {
      parseSpecAliasName(name);
      if (aliases.has(name)) throw new Error(`duplicate spec alias: ${name}`);
      aliases.set(name, parseSpecAliasTarget(target));
    } catch (error) {
      fail(`invalid spec alias at ${filePath}:${lineNumber}: ${error.message}`);
    }
  };

  for (let index = 0; index < lines.length; index++) {
    const line = lines[index];
    if (!line.trim() || isConfigComment(line)) continue;

    if (line === '[spec-alias]') {
      if (!allowAliases) {
        fail(`spec alias sections are not allowed in ${kind} at ${filePath}:${index + 1}`);
      }
      if (aliasSectionSeen) {
        fail(`duplicate [spec-alias] section at ${filePath}:${index + 1}`);
      }
      if (legacyAliasesSeen) {
        fail(`legacy spec aliases cannot be combined with [spec-alias] at ${filePath}:${index + 1}`);
      }
      aliasSectionSeen = true;

      let aliasIndex = index + 1;
      for (; aliasIndex < lines.length; aliasIndex++) {
        const aliasLine = lines[aliasIndex];
        if (isConfigComment(aliasLine)) continue;
        if (trimConfigWhitespace(aliasLine) === '' || aliasLine.startsWith('[')) break;
        const alias = parseConfigAssignment(aliasLine);
        if (alias === undefined) {
          fail(
            `invalid spec alias at ${filePath}:${aliasIndex + 1}; `
            + 'expected <name>=<agent-spec-prefix>',
          );
        }
        addSpecAlias(alias.name, alias.value, aliasIndex + 1);
      }
      index = aliasIndex - 1;
      continue;
    }
    if (line.startsWith('[spec-alias')) {
      fail(`invalid spec alias header at ${filePath}:${index + 1}; expected [spec-alias]`);
    }

    if (line.startsWith('[profile:')) {
      if (!allowProfiles) {
        fail(`profile sections are not allowed in ${kind} at ${filePath}:${index + 1}`);
      }
      const match = /^\[profile:(\S+)\]$/.exec(line);
      if (match === null) {
        fail(`invalid profile header at ${filePath}:${index + 1}; expected [profile:<name>]`);
      }
      let profileName;
      try {
        profileName = parseProfileName(match[1]);
      } catch (error) {
        fail(`invalid profile header at ${filePath}:${index + 1}: ${error.message}`);
      }
      if (rawProfiles.has(profileName)) {
        fail(`duplicate profile "${profileName}" at ${filePath}:${index + 1}`);
      }
      const profile = parseRawProfileBlock(lines, index, profileName, filePath, kind);
      rawProfiles.set(profileName, profile.assignments);
      index = profile.lastIndex;
      continue;
    }

    const configAssignment = parseConfigAssignment(line);
    if (
      configAssignment === undefined
      || configAssignment.name === ''
      || configAssignment.value === ''
    ) {
      fail(`invalid ${kind} at ${filePath}:${index + 1}; expected <specialist-role>=<spec>`);
    }
    const { name: assignment, value } = configAssignment;
    if (assignment.startsWith('spec-alias:')) {
      if (!allowAliases) {
        fail(`unknown specialist role in ${kind} at ${filePath}:${index + 1}: ${assignment}`);
      }
      if (!allowLegacyAliases) {
        fail(
          `legacy spec alias syntax is not allowed at ${filePath}:${index + 1}; `
          + 'use one [spec-alias] section',
        );
      }
      if (aliasSectionSeen) {
        fail(`legacy spec aliases cannot be combined with [spec-alias] at ${filePath}:${index + 1}`);
      }
      legacyAliasesSeen = true;
      addSpecAlias(assignment.slice('spec-alias:'.length), value, index + 1);
      continue;
    }

    if (assignment === 'base-profile') {
      if (!allowBaseProfile) {
        fail(`unknown specialist role in ${kind} at ${filePath}:${index + 1}: ${assignment}`);
      }
      if (baseProfile !== undefined) {
        fail(`duplicate base profile in ${kind} at ${filePath}:${index + 1}`);
      }
      try {
        baseProfile = parseProfileName(value);
      } catch (error) {
        fail(`invalid base profile in ${kind} at ${filePath}:${index + 1}: ${error.message}`);
      }
      if (baseProfile === defaultProfileName) {
        fail(`invalid base profile in ${kind} at ${filePath}:${index + 1}: default must be omitted`);
      }
      continue;
    }

    if (assignment === 'default-profile') {
      if (!allowDefaultProfile) {
        fail(`unknown specialist role in ${kind} at ${filePath}:${index + 1}: ${assignment}`);
      }
      if (defaultProfile !== undefined) {
        fail(`duplicate default profile in ${kind} at ${filePath}:${index + 1}`);
      }
      try {
        defaultProfile = parseProfileName(value);
      } catch (error) {
        fail(`invalid default profile in ${kind} at ${filePath}:${index + 1}: ${error.message}`);
      }
      continue;
    }

    if (assignment.startsWith('profile:')) {
      fail(
        `invalid profile syntax at ${filePath}:${index + 1}; `
        + 'use [profile:<name>] followed by oracle, finder, librarian, and reporter assignments',
      );
    }

    if (assignment.startsWith('spec-label:')) {
      if (!allowSpecLabels) {
        fail(`unknown specialist role in ${kind} at ${filePath}:${index + 1}: ${assignment}`);
      }
      const name = assignment.slice('spec-label:'.length);
      if (!ROLE_NAMES.includes(name)) {
        fail(`unknown specialist role in ${kind} at ${filePath}:${index + 1}: ${assignment}`);
      }
      if (rawSpecLabels[name] !== undefined) {
        fail(`duplicate ${name} spec label in ${kind} at ${filePath}:${index + 1}`);
      }
      rawSpecLabels[name] = { spec: value, line: index + 1 };
      continue;
    }

    const name = assignment;
    const spec = value;
    if (!ROLE_NAMES.includes(name)) {
      fail(`unknown specialist role in ${kind} at ${filePath}:${index + 1}: ${name}`);
    }
    if (allowProfiles) {
      fail(
        `unprefixed role assignments are not allowed in ${kind} at ${filePath}:${index + 1}`,
      );
    }
    if (seen.has(name)) fail(`duplicate ${name} ${kind} at ${filePath}:${index + 1}`);
    seen.add(name);
    rawSpecs[name] = { spec, line: index + 1 };
  }

  const parseOptions = { aliases, kind, resolveAliases };
  const specs = parseRawRoleAssignments(rawSpecs, filePath, {
    ...parseOptions,
    requireAll,
  });
  const specLabels = parseStoredSpecLabels(rawSpecLabels, specs, filePath, kind);
  const profiles = new Map();
  const profileSpecLabels = new Map();
  for (const [profileName, assignments] of rawProfiles) {
    profiles.set(profileName, parseRawRoleAssignments(assignments, filePath, {
      ...parseOptions,
      profileName,
      requireAll: true,
    }));
    profileSpecLabels.set(profileName, rawRoleSpecLabels(assignments));
  }
  return {
    aliases,
    baseProfile,
    defaultProfile,
    profileSpecLabels,
    profiles,
    specLabels,
    specs,
  };
}

async function readUserRoleDefaults() {
  const home = process.env.HOME;
  if (!home) fail('HOME is not set; cannot resolve role defaults file');
  let relativePath = userRoleDefaultsRelativePaths[0];
  let defaultsPath = path.join(home, relativePath);
  let info;
  for (const candidateRelativePath of userRoleDefaultsRelativePaths) {
    const candidatePath = path.join(home, candidateRelativePath);
    let candidateInfo;
    try {
      candidateInfo = await requireOwnedRegularFileIfPresent(
        candidatePath,
        'role defaults file',
      );
    } catch (error) {
      fail(`cannot inspect role defaults file: ${candidatePath}: ${error.message}`);
    }
    if (!candidateInfo) continue;
    relativePath = candidateRelativePath;
    defaultsPath = candidatePath;
    info = candidateInfo;
    break;
  }
  const displayPath = `$HOME/${relativePath}`;
  if (!info) {
    return {
      aliases: bundledDefaults.aliases,
      defaultProfile: undefined,
      profileSpecLabels: new Map(),
      profiles: new Map(),
      specLabels: {},
      specs: {},
      displayPath,
      path: defaultsPath,
      shouldCreate: true,
      aliasesUpgraded: false,
      profileUpgraded: false,
      home,
    };
  }
  let content;
  try {
    content = await readFile(defaultsPath, 'utf8');
  } catch (error) {
    fail(`cannot read role defaults file: ${defaultsPath}: ${error.message}`);
  }
  const upgraded = await upgradeLegacyUserConfig(content, defaultsPath, info);
  const config = parseConfigAssignments(upgraded.content, defaultsPath, {
    allowAliases: true,
    allowDefaultProfile: true,
    allowProfiles: true,
    resolveAliases: true,
  });
  return {
    ...config,
    displayPath,
    path: defaultsPath,
    shouldCreate: false,
    aliasesUpgraded: upgraded.aliasesUpgraded,
    profileUpgraded: upgraded.profileUpgraded,
    home,
  };
}

function configuredDefaultProfile(userDefaults) {
  if (userDefaults.defaultProfile !== undefined) return userDefaults.defaultProfile;
  if (userDefaults.profiles.has(defaultProfileName)) {
    return defaultProfileName;
  }
  return bundledDefaultProfileName;
}

function resolveProfile(profileName, userDefaults) {
  if (userDefaults.profiles.has(profileName)) {
    return {
      specs: userDefaults.profiles.get(profileName),
      specLabels: userDefaults.profileSpecLabels.get(profileName),
    };
  }
  const specs = bundledProfiles.get(profileName);
  if (specs === undefined) fail(`unknown profile: ${profileName}`);
  return {
    specs,
    specLabels: bundledDefaults.profileSpecLabels.get(profileName),
  };
}

async function createBundledRoleDefaults(defaultsPath) {
  try {
    await mkdir(path.dirname(defaultsPath), { recursive: true, mode: 0o700 });
  } catch (error) {
    fail(`cannot create role defaults directory: ${path.dirname(defaultsPath)}: ${error.message}`);
  }
  try {
    await writeFile(defaultsPath, bundledRoleDefaultsContent, {
      encoding: 'utf8',
      mode: 0o600,
      flag: 'wx',
    });
  } catch (error) {
    if (error?.code === 'EEXIST') {
      fail(`role defaults file appeared during setup; rerun to use it: ${defaultsPath}`);
    }
    fail(`cannot create role defaults file: ${defaultsPath}: ${error.message}`);
  }
  return lstat(defaultsPath);
}

async function rollbackCreatedRoleDefaults(defaultsPath, identity) {
  const current = await lstatIfPresent(defaultsPath);
  if (
    current
    && !current.isSymbolicLink()
    && current.isFile()
    && current.dev === identity.dev
    && current.ino === identity.ino
  ) {
    await rm(defaultsPath);
  }
}

function renderRoleAssignments(specs) {
  return `${ROLE_NAMES.map((name) => `${name}=${specs[name]}`).join('\n')}\n`;
}

function renderSpecAliases(aliases) {
  if (aliases.size === 0) return '';
  const entries = [...aliases].sort(([left], [right]) => {
    if (left < right) return -1;
    if (left > right) return 1;
    return 0;
  });
  return `[spec-alias]\n${entries.map(([name, target]) => `${name}=${target}`).join('\n')}\n`;
}

function renderRoleConfig(roles) {
  return renderRoleAssignments(Object.fromEntries(
    roles.map((role) => [role.name, canonicalAgentSpecList(role.configs)]),
  ));
}

function renderSpecLabelAssignments(specs, specLabels) {
  const assignments = ROLE_NAMES.flatMap((name) => {
    const label = specLabels[name];
    return label === specs[name] ? [] : [`spec-label:${name}=${label}`];
  });
  return assignments.length === 0 ? '' : `${assignments.join('\n')}\n`;
}

function renderSpecLabels(roles) {
  const specs = Object.fromEntries(
    roles.map((role) => [role.name, canonicalAgentSpecList(role.configs)]),
  );
  const specLabels = Object.fromEntries(
    roles.map((role) => [role.name, role.specLabels.join(',')]),
  );
  return renderSpecLabelAssignments(specs, specLabels);
}

function renderBaseProfile(profileName) {
  return profileName === defaultProfileName ? '' : `base-profile=${profileName}\n`;
}

function renderActiveSelection(roles, profileName) {
  return `${renderBaseProfile(profileName)}${renderRoleConfig(roles)}`;
}

function renderActiveConfig(roles, aliases, profileName) {
  return `${renderActiveSelection(roles, profileName)}${renderSpecLabels(roles)}${renderSpecAliases(aliases)}`;
}

async function readActiveRoleConfig(filePath) {
  const info = await requireOwnedRegularFileIfPresent(filePath, 'active role config');
  if (!info) return undefined;
  let content;
  try {
    content = await readFile(filePath, 'utf8');
  } catch (error) {
    fail(`cannot read active role config: ${filePath}: ${error.message}`);
  }
  const config = parseConfigAssignments(content, filePath, {
    allowAliases: true,
    allowBaseProfile: true,
    allowLegacyAliases: true,
    allowSpecLabels: true,
    requireAll: true,
    kind: 'active role config',
  });
  if ((info.mode & 0o777) !== 0o600) await chmod(filePath, 0o600);
  return config;
}

async function lstatIfPresent(filePath) {
  try {
    return await lstat(filePath);
  } catch (error) {
    if (error?.code === 'ENOENT') return undefined;
    throw error;
  }
}

async function readBundledFile(filePath, kind) {
  try {
    return await readFile(filePath, 'utf8');
  } catch (error) {
    fail(`cannot read bundled ${kind}: ${filePath}: ${error.message}`);
  }
}

async function requireBundledFile(filePath, kind, { executable = false } = {}) {
  let info;
  try {
    info = await lstat(filePath);
  } catch (error) {
    fail(`cannot inspect bundled ${kind}: ${filePath}: ${error.message}`);
  }
  if (info.isSymbolicLink() || !info.isFile()) fail(`refusing unsafe bundled ${kind}: ${filePath}`);
  if (executable && (info.mode & 0o111) === 0) {
    fail(`bundled ${kind} is not executable: ${filePath}`);
  }
  return readBundledFile(filePath, kind);
}

async function requireOwnedRegularFileIfPresent(filePath, kind) {
  const info = await lstatIfPresent(filePath);
  if (!info) return undefined;
  if (info.isSymbolicLink() || !info.isFile()) fail(`refusing unsafe ${kind}: ${filePath}`);
  if (typeof process.getuid === 'function' && info.uid !== process.getuid()) {
    fail(`${kind} is owned by another user: ${filePath}`);
  }
  return info;
}

async function inspectPrivateDirectory(directory) {
  const existing = await lstatIfPresent(directory);
  if (existing) {
    if (existing.isSymbolicLink() || !existing.isDirectory()) {
      fail(`refusing unsafe existing state path: ${directory}`);
    }
    if (typeof process.getuid === 'function' && existing.uid !== process.getuid()) {
      fail(`existing state directory is owned by another user: ${directory}`);
    }
  }
  return existing;
}

async function ensurePrivateDirectory(directory) {
  const existing = await inspectPrivateDirectory(directory);
  if (!existing) await mkdir(directory, { mode: 0o700 });
  await chmod(directory, 0o700);
}

async function atomicWrite(target, data, mode) {
  const temporary = path.join(
    path.dirname(target),
    `.${path.basename(target)}.${process.pid}.${crypto.randomUUID()}.tmp`,
  );
  await writeFile(temporary, data, { encoding: 'utf8', mode, flag: 'wx' });
  try {
    await rename(temporary, target);
    await chmod(target, mode);
  } catch (error) {
    await rm(temporary, { force: true });
    throw error;
  }
}

async function atomicWriteIfChanged(target, data, mode, kind) {
  const info = await lstatIfPresent(target);
  if (info) {
    if (info.isSymbolicLink() || !info.isFile()) fail(`refusing unsafe ${kind}: ${target}`);
    if (typeof process.getuid === 'function' && info.uid !== process.getuid()) {
      fail(`${kind} is owned by another user: ${target}`);
    }
    let existingData;
    try {
      existingData = await readFile(target, 'utf8');
    } catch {
      existingData = undefined;
    }
    if (existingData === data) {
      if ((info.mode & 0o777) !== mode) await chmod(target, mode);
      return;
    }
  }
  await atomicWrite(target, data, mode);
}

async function readExistingInstallation(filePath) {
  const info = await requireOwnedRegularFileIfPresent(filePath, 'installation record');
  if (!info) return undefined;
  let installation;
  try {
    installation = JSON.parse(await readFile(filePath, 'utf8'));
  } catch {
    fail(`invalid installation record JSON: ${filePath}`);
  }
  if (
    installation?.schemaVersion !== 1
    || typeof installation.garconPath !== 'string'
    || typeof installation.sandboxPath !== 'string'
    || (installation.garconCliExecutable !== undefined
      && typeof installation.garconCliExecutable !== 'string')
  ) {
    fail(`invalid installation record schema: ${filePath}`);
  }
  if ((info.mode & 0o777) !== 0o600) await chmod(filePath, 0o600);
  return installation;
}

function garconCliCommand(garconCli, ...args) {
  const command = garconCli.garconCliRunner === 'bun'
    ? ['bun', garconCli.garconCliPath]
    : [garconCli.garconCliPath];
  return [...command, ...args];
}

async function publishSetupNotice(garconCli, chatId, title, content) {
  const child = Bun.spawn({
    cmd: garconCliCommand(
      garconCli, 'add-row', chatId,
      '--type', 'notice', '--title', title, '-',
    ),
    cwd: garconCli.garconPath,
    env: process.env,
    stdin: 'pipe',
    stdout: 'ignore',
    stderr: 'inherit',
  });
  child.stdin.write(content);
  child.stdin.end();
  return child.exited;
}

function parseOptions(args) {
  if (args.length === 1 && (args[0] === '--help' || args[0] === '-h')) {
    console.log(usage);
    process.exit(0);
  }
  if (args.length === 0 || args[0].startsWith('-')) fail(usage);

  const chatId = args[0];
  const seen = new Set();
  const roleSpecs = {};
  let requestedGarconPath;
  let requestedProfile;
  let requestedSharedSandbox;
  let resetDefaults = false;

  for (let index = 1; index < args.length;) {
    const option = args[index];
    if (!option?.startsWith('--')) fail(usage);
    if (option !== '--oracle' && seen.has(option)) fail(`duplicate option: ${option}`);
    seen.add(option);

    if (option === '--reset-defaults') {
      resetDefaults = true;
      index += 1;
      continue;
    }

    const value = args[index + 1];
    if (value === undefined || value.startsWith('--')) fail(usage);

    if (option === '--garcon-path') {
      requestedGarconPath = value;
      index += 2;
      continue;
    }

    if (option === '--shared-sandbox') {
      requestedSharedSandbox = value;
      index += 2;
      continue;
    }

    if (option === '--profile') {
      try {
        requestedProfile = parseProfileName(value);
      } catch (error) {
        fail(error.message);
      }
      index += 2;
      continue;
    }

    const role = option.slice(2);
    if (!ROLE_NAMES.includes(role)) fail(`unknown option: ${option}`);
    roleSpecs[role] ??= [];
    roleSpecs[role].push(value);
    index += 2;
  }

  return {
    chatId,
    requestedGarconPath,
    requestedProfile,
    requestedSharedSandbox,
    roleSpecs,
    resetDefaults,
  };
}

function assertInstructionValue(kind, value) {
  if (/\p{Cc}/u.test(value)) fail(`${kind} contains a control character and cannot be printed safely`);
  if (/[\p{Cf}\u2028\u2029]/u.test(value)) {
    fail(`${kind} contains a formatting character and cannot be printed safely`);
  }
  if (value.includes(instructionsBeginMarker) || value.includes(instructionsEndMarker)) {
    fail(`${kind} contains an instruction packet marker and cannot be printed safely`);
  }
}

function renderInstructions(template, values) {
  if (template.includes(instructionsBeginMarker) || template.includes(instructionsEndMarker)) {
    fail('runtime instruction template contains an instruction packet marker');
  }
  const placeholderFreeTemplate = template.replace(/\{\{[A-Z_]+\}\}/g, '');
  if (placeholderFreeTemplate.includes('{{') || placeholderFreeTemplate.includes('}}')) {
    fail('unresolved runtime instruction placeholder');
  }
  const body = template.replace(/\{\{([A-Z_]+)\}\}/g, (placeholder, name) => {
    const value = values[name];
    if (value === undefined) fail(`unknown runtime instruction placeholder: ${placeholder}`);
    assertInstructionValue(`runtime instruction value ${name}`, value);
    return value;
  });
  const packet = `${instructionsBeginMarker}\n${body.trimEnd()}\n${instructionsEndMarker}\n`;
  const byteLength = new TextEncoder().encode(packet).byteLength;
  if (byteLength > instructionsMaxBytes) {
    fail(`runtime instruction packet is ${byteLength} bytes; maximum is ${instructionsMaxBytes}`);
  }
  return packet;
}

function installationFor(garconCli, sandboxPath) {
  return {
    schemaVersion: 1,
    garconPath: garconCli.garconPath,
    sandboxPath,
    ...(garconCli.garconCliRunner === 'direct'
      ? { garconCliExecutable: garconCli.garconCliPath }
      : {}),
  };
}

async function resolveSharedSandbox(directory, recovery) {
  try {
    const resolved = await realpath(directory);
    if (!(await stat(resolved)).isDirectory()) throw new Error('not a directory');
    return resolved;
  } catch {
    fail(`shared sandbox is not an existing directory: ${directory}; ${recovery}`);
  }
}

function openCodeConfig(agentName, role) {
  const editAndBashPermission = role === 'finder' ? 'deny' : 'allow';
  return JSON.stringify({
    share: 'disabled',
    subagent_depth: 0,
    agent: {
      [agentName]: {
        description: `Garcon-Amp ${role} specialist`,
        mode: 'primary',
        permission: {
          '*': 'deny',
          read: 'allow',
          edit: editAndBashPermission,
          bash: editAndBashPermission,
          glob: 'allow',
          grep: 'allow',
          list: 'allow',
          external_directory: 'allow',
          task: 'deny',
          question: 'deny',
          plan_enter: 'deny',
          plan_exit: 'deny',
        },
      },
    },
  });
}

const {
  chatId,
  requestedGarconPath,
  requestedProfile,
  requestedSharedSandbox,
  roleSpecs,
  resetDefaults,
} = parseOptions(Bun.argv.slice(2));
if (!/^\d{16}$/.test(chatId)) fail('Garcon chat ID must contain exactly 16 digits');
const userRoleDefaults = await readUserRoleDefaults();
const selectedDefaultProfileName = configuredDefaultProfile(userRoleDefaults);
resolveProfile(selectedDefaultProfileName, userRoleDefaults);

const statePath = path.join('/tmp', `garcon-amp-${chatId}`);
const existingState = await inspectPrivateDirectory(statePath);
if (existingState) await chmod(statePath, 0o700);
const activeConfigPath = path.join(statePath, activeConfigFileName);
const installationPath = path.join(statePath, installationFileName);
const existingRoleConfig = await readActiveRoleConfig(activeConfigPath);
const existingInstallation = await readExistingInstallation(installationPath);

const selectedGarconPath = requestedGarconPath ?? existingInstallation?.garconPath;
const selectedGarconCliExecutable = requestedGarconPath === undefined
  ? existingInstallation?.garconCliExecutable
  : undefined;

const shouldApplyProfile = requestedProfile !== undefined
  || resetDefaults
  || existingRoleConfig === undefined;
const selectedProfileName = shouldApplyProfile
  ? requestedProfile ?? selectedDefaultProfileName
  : existingRoleConfig.baseProfile ?? defaultProfileName;
const selectedProfile = shouldApplyProfile
  ? resolveProfile(selectedProfileName, userRoleDefaults)
  : undefined;

const roles = ROLE_NAMES.map((name) => {
  let configs;
  let specLabels;
  try {
    const explicitSpecs = roleSpecs[name];
    if (explicitSpecs !== undefined) {
      specLabels = explicitSpecs;
      configs = explicitSpecs.map((spec) => parseAgentSpecWithAliases(
        spec,
        userRoleDefaults.aliases,
      ));
      const canonicalSpecs = configs.map(canonicalAgentSpec);
      if (new Set(canonicalSpecs).size !== canonicalSpecs.length) {
        const changed = explicitSpecs.some((spec, index) => spec !== canonicalSpecs[index]);
        throw new Error(`agent spec list contains a duplicate${changed ? ' after alias resolution' : ''}`);
      }
    } else {
      const source = selectedProfile ?? existingRoleConfig;
      const spec = source.specs[name];
      specLabels = source.specLabels[name].split(',');
      configs = parseAgentSpecList(spec);
    }
    if (name !== 'oracle' && configs.length !== 1) {
      throw new Error('only oracle may configure multiple agent specs');
    }
  } catch (error) {
    fail(`invalid ${name} agent spec: ${error.message}`);
  }
  return { name, ...roleDefinitions[name], configs, specLabels };
});

let garconCli;
if (selectedGarconCliExecutable !== undefined) {
  const resolved = await resolveGarconCliExecutable(selectedGarconCliExecutable);
  if (resolved === undefined) {
    fail(`recorded Garcon CLI executable is unavailable: ${selectedGarconCliExecutable}`);
  }
  garconCli = resolved;
} else if (selectedGarconPath === undefined) {
  garconCli = await discoverGarconCli(
    Bun.which('garcon-cli') ?? undefined,
    defaultGarconRootCandidates(userRoleDefaults.home),
  );
  if (garconCli === undefined) fail(MISSING_GARCON_CLI_MESSAGE);
} else {
  let garconPath;
  try {
    garconPath = await realpath(selectedGarconPath);
    if (!(await stat(garconPath)).isDirectory()) throw new Error('not a directory');
  } catch {
    fail(`Garcon repository root is not an existing directory: ${selectedGarconPath}`);
  }
  const garconCliPath = await findGarconCliPath(garconPath);
  if (garconCliPath === undefined) {
    fail(`Garcon repository root has no cli/main or cli/main.ts: ${garconPath}`);
  }
  garconCli = { garconPath, garconCliPath, garconCliRunner: 'bun' };
}
const { garconPath, garconCliPath, garconCliRunner } = garconCli;

const defaultSandboxPath = path.join(statePath, 'sandbox');
const storedSandboxPath = requestedSharedSandbox === undefined && !resetDefaults
  ? existingInstallation?.sandboxPath
  : undefined;
const selectedSandboxPath = requestedSharedSandbox
  ?? storedSandboxPath
  ?? defaultSandboxPath;
if (requestedSharedSandbox !== undefined && !path.isAbsolute(requestedSharedSandbox)) {
  fail(`shared sandbox must be an absolute directory path: ${requestedSharedSandbox}`);
}
let sandboxPath = selectedSandboxPath;
if (requestedSharedSandbox === undefined && selectedSandboxPath !== defaultSandboxPath) {
  sandboxPath = await resolveSharedSandbox(
    selectedSandboxPath,
    'recreate it, pass --shared-sandbox <absolute-directory> to create or select one, or use --reset-defaults',
  );
}

for (const binary of new Set([
  'bun',
  'setsid',
  ...roles.flatMap((role) => role.configs.map((config) => config.agent)),
])) {
  if (!Bun.which(binary)) fail(`required selected executable is not on PATH: ${binary}`);
}

const transcriptQueryPath = path.join(skillPath, 'transcript-query');
const transcriptXmlPath = path.join(skillPath, 'lib', 'transcript-xml.ts');
await requireBundledFile(transcriptQueryPath, 'transcript query tool', { executable: true });
await requireBundledFile(transcriptXmlPath, 'transcript query library');
const template = await readBundledFile(
  path.join(skillPath, 'assets', 'role-launcher.sh'),
  'launcher template',
);
const instructionsTemplate = await readBundledFile(
  path.join(skillPath, 'prompts', 'ORCHESTRATOR.md'),
  'runtime instruction template',
);

if (requestedSharedSandbox !== undefined) {
  assertInstructionValue('shared sandbox path', selectedSandboxPath);
  try {
    await mkdir(selectedSandboxPath, { recursive: true, mode: 0o700 });
  } catch (error) {
    fail(`cannot create shared sandbox: ${selectedSandboxPath}: ${error.message}`);
  }
  sandboxPath = await resolveSharedSandbox(
    selectedSandboxPath,
    'the explicit path could not be resolved after its creation check; check path access and retry',
  );
}

await ensurePrivateDirectory(statePath);
await ensurePrivateDirectory(sandboxPath);

const generatedRoles = roles.map((role) => {
  const openCodeAgentName = `garcon-amp-${chatId}-${role.name}`;
  const replacements = {
    __ROLE__: role.name,
    __CHAT_ID__: chatId,
    __GARCON_PATH__: garconPath,
    __GARCON_CLI_PATH__: garconCliPath,
    __GARCON_CLI_RUNNER__: garconCliRunner,
    __GARCON_CLI_COMMAND__: garconCliRunner === 'bun'
      ? `bun ${shellQuote(garconCliPath)}`
      : shellQuote(garconCliPath),
    __TRANSCRIPT_QUERY_PATH__: transcriptQueryPath,
    __TRANSCRIPT_XML_PATH__: transcriptXmlPath,
    __STATE_PATH__: statePath,
    __SANDBOX_PATH__: sandboxPath,
    __ROLE_TITLE__: role.title,
    __ROLE_ACCENT__: role.accent,
    __ROLE_PROMPT_PATH__: path.join(skillPath, 'prompts', role.prompt),
    __REVIEW_PROMPT_PATH__: path.join(skillPath, 'prompts', 'REVIEW.md'),
    __OPENCODE_AGENT_NAME__: openCodeAgentName,
    __OPENCODE_CONFIG_JSON__: openCodeConfig(openCodeAgentName, role.name),
  };
  const launcher = template.replace(/__[A-Z_]+__/g, (placeholder) => {
    const value = replacements[placeholder];
    if (value === undefined) fail(`unknown launcher template placeholder: ${placeholder}`);
    return shellQuote(value);
  });
  if (/__[A-Z_]+__/.test(launcher)) fail(`unresolved launcher template placeholder for ${role.name}`);

  return { ...role, launcher };
});

const instructionsPath = path.join(statePath, instructionsFileName);
const instructionPacket = renderInstructions(instructionsTemplate, {
  CHAT_ID: chatId,
  STATE_PATH: statePath,
  INSTRUCTIONS_PATH: instructionsPath,
  GARCON_PATH: garconPath,
  SANDBOX_PATH: sandboxPath,
  ORACLE_PATH: path.join(statePath, 'oracle'),
  FINDER_PATH: path.join(statePath, 'finder'),
  LIBRARIAN_PATH: path.join(statePath, 'librarian'),
  REPORTER_PATH: path.join(statePath, 'reporter'),
});

const generatedArtifacts = generatedRoles.flatMap((role) => [
  {
    target: path.join(statePath, role.name),
    data: role.launcher,
    mode: 0o700,
    kind: 'generated role launcher',
  },
]);
const installationArtifact = {
  target: installationPath,
  data: `${JSON.stringify(installationFor(garconCli, sandboxPath), null, 2)}\n`,
  mode: 0o600,
  kind: 'installation record',
};
generatedArtifacts.push({
  target: instructionsPath,
  data: instructionPacket,
  mode: 0o600,
  kind: 'generated instruction file',
});

const activeRoleAssignments = renderRoleConfig(roles);
const activeSpecLabels = renderSpecLabels(roles);
const activeSelection = renderActiveSelection(roles, selectedProfileName);
const activeRoleConfig = renderActiveConfig(
  roles,
  userRoleDefaults.aliases,
  selectedProfileName,
);
const roleConfigChanged = existingRoleConfig === undefined
  || activeRoleAssignments !== renderRoleAssignments(existingRoleConfig.specs)
  || activeSpecLabels !== renderSpecLabelAssignments(
    existingRoleConfig.specs,
    existingRoleConfig.specLabels,
  );
const profileChanged = existingRoleConfig !== undefined
  && selectedProfileName !== (existingRoleConfig.baseProfile ?? defaultProfileName);
const specAliasesChanged = existingRoleConfig === undefined
  || renderSpecAliases(userRoleDefaults.aliases) !== renderSpecAliases(existingRoleConfig.aliases);
const setupNoticeTitle = existingRoleConfig === undefined
  ? initializationNoticeTitle
  : reinitializationNoticeTitle;
let setupNoticeConfig;
if (roleConfigChanged || profileChanged) {
  setupNoticeConfig = activeSelection;
} else if (specAliasesChanged) {
  setupNoticeConfig = `${specAliasesChangedNotice}\n`;
} else {
  setupNoticeConfig = `${noRoleChangesNotice}\n`;
}
let setupNoticeContent = setupNoticeConfig;
if (userRoleDefaults.shouldCreate) {
  setupNoticeContent += `\nCreated ${userRoleDefaults.displayPath} with defaults\n`;
} else if (userRoleDefaults.aliasesUpgraded || userRoleDefaults.profileUpgraded) {
  const upgradedSections = [
    ...(userRoleDefaults.aliasesUpgraded ? ['[spec-alias]'] : []),
    ...(userRoleDefaults.profileUpgraded ? ['[profile:default]'] : []),
  ];
  setupNoticeContent += `\nUpgraded ${userRoleDefaults.displayPath} to ${upgradedSections.join(' and ')}\n`;
}

for (const artifact of generatedArtifacts) {
  await atomicWriteIfChanged(
    artifact.target,
    artifact.data,
    artifact.mode,
    artifact.kind,
  );
}

let createdRoleDefaultsIdentity;
if (userRoleDefaults.shouldCreate) {
  createdRoleDefaultsIdentity = await createBundledRoleDefaults(userRoleDefaults.path);
}
const noticeStatus = await publishSetupNotice(
  garconCli,
  chatId,
  setupNoticeTitle,
  setupNoticeContent,
);
if (noticeStatus !== 0) {
  if (createdRoleDefaultsIdentity) {
    await rollbackCreatedRoleDefaults(userRoleDefaults.path, createdRoleDefaultsIdentity);
  }
  fail(
    `could not publish ${setupNoticeTitle} notice; active role config was not changed (exit ${noticeStatus})`,
  );
}
await atomicWriteIfChanged(
  installationArtifact.target,
  installationArtifact.data,
  installationArtifact.mode,
  installationArtifact.kind,
);
await atomicWriteIfChanged(activeConfigPath, activeRoleConfig, 0o600, 'active role config');
process.stdout.write(instructionPacket);
